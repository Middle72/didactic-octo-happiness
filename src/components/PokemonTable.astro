---
import type { Pokemon } from '../data/pokemon';
import { typeColor } from '../data/type-colors';
import { ALL_TYPES } from '../data/type-effectiveness';

interface Props {
  pokemon: Pokemon[];
}

const { pokemon } = Astro.props;

const allTypes = Array.from(
  new Set(pokemon.flatMap(p => p.types.split('/').map(t => t.trim())))
).sort();

const COLUMNS = [
  { key: 'name', label: 'Species / Nickname', sortType: 'text' },
  { key: 'types', label: 'Type(s)', sortType: 'text' },
  { key: 'cp', label: 'CP', sortType: 'number' },
  { key: 'levelRange', label: 'Level Range', sortType: 'text' },
  { key: 'atk', label: 'Atk', sortType: 'number' },
  { key: 'def', label: 'Def', sortType: 'number' },
  { key: 'hp', label: 'HP', sortType: 'number' },
  { key: 'iv', label: 'IV Total / %', sortType: 'text' },
  { key: 'fastAttack', label: 'Fast Attack', sortType: 'text' },
  { key: 'chargedAttack1', label: 'Charged Attack 1', sortType: 'text' },
  { key: 'chargedAttack2', label: 'Charged Attack 2', sortType: 'text' },
  { key: 'notes', label: 'Battle Notes & Mega Readiness', sortType: 'text' },
];
---
{pokemon.length === 0 ? (
  <p class="pokemon-empty">No Pokemon added yet.</p>
) : (
  <div class="pokemon-table-container">
    <div class="pokemon-filters">
      <input type="search" class="pokemon-search" placeholder="Search by name or species&hellip;" />
      <select class="pokemon-type-filter">
        <option value="">All Types</option>
        {allTypes.map(t => <option value={t}>{t}</option>)}
      </select>
      <select class="pokemon-raid-filter">
        <option value="">Suggest counters for raid boss type&hellip;</option>
        {ALL_TYPES.map(t => <option value={t}>vs {t}</option>)}
      </select>
      <span class="pokemon-count"></span>
    </div>

    <div class="pokemon-table-wrap">
      <table class="pokemon-table">
        <thead>
          <tr>
            <th></th>
            {COLUMNS.map(col => (
              <th class="pokemon-sortable" data-key={col.key} data-sort-type={col.sortType}>
                {col.label}
                <span class="sort-arrow"></span>
              </th>
            ))}
            <th class="pokemon-sortable" data-key="raidEff" data-sort-type="number">
              vs Raid Boss
              <span class="sort-arrow"></span>
            </th>
          </tr>
        </thead>
        <tbody>
          {pokemon.map((p, i) => (
            <tr
              data-row-index={i}
              data-name={p.name.toLowerCase()}
              data-species={p.species.toLowerCase()}
              data-types={p.types.toLowerCase()}
              data-cp={p.cp}
              data-level-range={p.levelRange}
              data-atk={p.atk ?? ''}
              data-def={p.def ?? ''}
              data-hp={p.hp ?? ''}
              data-iv={p.iv}
              data-fast-attack={p.fastAttack}
              data-charged-attack1={p.chargedAttack1}
              data-charged-attack2={p.chargedAttack2}
              data-notes={p.notes}
              data-raid-eff=""
            >
              <td class="pokemon-icon-cell">
                <a href={`https://pokemondb.net/pokedex/${p.species}`} target="_blank" rel="noopener noreferrer">
                  <span class="pokemon-icon-slot">
                    <img
                      class="pokemon-icon"
                      src={`https://img.pokemondb.net/sprites/home/normal/${p.species}.png`}
                      alt={p.species}
                      loading="lazy"
                      width="40"
                      height="40"
                      onerror="this.closest('.pokemon-icon-slot').style.visibility='hidden'"
                    />
                  </span>
                </a>
              </td>
              <td class="pokemon-name-cell">{p.name}</td>
              <td>
                <div class="type-badges">
                  {p.types.split('/').map(t => (
                    <span class="type-badge" style={`background:${typeColor(t)}`}>{t.trim()}</span>
                  ))}
                </div>
              </td>
              <td>{p.cp}</td>
              <td>{p.levelRange}</td>
              <td>{p.atk ?? '—'}</td>
              <td>{p.def ?? '—'}</td>
              <td>{p.hp ?? '—'}</td>
              <td>{p.iv}</td>
              <td class="pokemon-move-cell">{p.fastAttack} <span class="move-eff"></span></td>
              <td class="pokemon-move-cell">{p.chargedAttack1} <span class="move-eff"></span></td>
              <td class="pokemon-move-cell">{p.chargedAttack2} <span class="move-eff"></span></td>
              <td class="pokemon-notes-cell">{p.notes}</td>
              <td class="raid-eff-cell">&mdash;</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
)}

<script>
  import { effectiveness, moveType } from '../data/type-effectiveness';

  document.querySelectorAll('.pokemon-table-container').forEach(container => {
    const searchEl = container.querySelector<HTMLInputElement>('.pokemon-search');
    const typeEl = container.querySelector<HTMLSelectElement>('.pokemon-type-filter');
    const raidEl = container.querySelector<HTMLSelectElement>('.pokemon-raid-filter');
    const countEl = container.querySelector<HTMLElement>('.pokemon-count');
    const tbody = container.querySelector('tbody');
    if (!searchEl || !typeEl || !raidEl || !countEl || !tbody) return;

    const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr'));

    function applyFilter() {
      const query = (searchEl as HTMLInputElement).value.trim().toLowerCase();
      const type = (typeEl as HTMLSelectElement).value.toLowerCase();
      let visible = 0;
      rows.forEach(row => {
        const matchesQuery =
          !query ||
          (row.dataset.name ?? '').includes(query) ||
          (row.dataset.species ?? '').includes(query);
        const matchesType = !type || (row.dataset.types ?? '').includes(type);
        const show = matchesQuery && matchesType;
        row.hidden = !show;
        if (show) visible++;
      });
      countEl!.textContent = `${visible} of ${rows.length}`;
    }

    searchEl.addEventListener('input', applyFilter);
    typeEl.addEventListener('change', applyFilter);
    applyFilter();

    function sortRowsBy(key: string, sortType: string | undefined, asc: boolean) {
      rows.sort((a, b) => {
        const av = a.dataset[key] ?? '';
        const bv = b.dataset[key] ?? '';
        const cmp = sortType === 'number' ? Number(av) - Number(bv) : av.localeCompare(bv);
        return asc ? cmp : -cmp;
      });
      rows.forEach(row => tbody!.appendChild(row));
    }

    function setActiveSortHeader(key: string, asc: boolean) {
      container.querySelectorAll('.pokemon-sortable').forEach(h => h.classList.remove('sort-asc', 'sort-desc'));
      const th = container.querySelector<HTMLElement>(`.pokemon-sortable[data-key="${key}"]`);
      th?.classList.add(asc ? 'sort-asc' : 'sort-desc');
    }

    let sortKey = '';
    let sortAsc = true;

    container.querySelectorAll<HTMLElement>('.pokemon-sortable').forEach(th => {
      th.addEventListener('click', () => {
        const key = th.dataset.key!;
        sortAsc = sortKey === key ? !sortAsc : true;
        sortKey = key;
        setActiveSortHeader(key, sortAsc);
        sortRowsBy(key, th.dataset.sortType, sortAsc);
      });
    });

    const EFFECT_LABEL: Record<number, string> = {
      2: 'Super Effective',
      1: 'Neutral',
      0.5: 'Resisted',
      0: 'No Effect',
    };

    function clearMoveBadge(span: HTMLElement) {
      span.textContent = '';
      span.className = 'move-eff';
      span.removeAttribute('title');
    }

    function setMoveBadge(span: HTMLElement, move: string | undefined, bossType: string) {
      const type = moveType(move ?? '');
      if (!type) {
        clearMoveBadge(span);
        return;
      }
      const mult = effectiveness(type, bossType);
      const label = EFFECT_LABEL[mult] ?? 'Neutral';
      span.textContent = `${mult}×`;
      span.className = `move-eff move-eff-${String(mult).replace('.', '_')}`;
      span.title = label;
    }

    raidEl.addEventListener('change', () => {
      const bossType = raidEl.value;

      if (!bossType) {
        rows.forEach(row => {
          row.dataset.raidEff = '';
          const cell = row.querySelector<HTMLElement>('.raid-eff-cell');
          if (cell) {
            cell.textContent = '—';
            cell.className = 'raid-eff-cell';
          }
          row.querySelectorAll<HTMLElement>('.move-eff').forEach(clearMoveBadge);
        });
        sortKey = 'rowIndex';
        sortAsc = true;
        setActiveSortHeader('name', true);
        container.querySelectorAll('.pokemon-sortable').forEach(h => h.classList.remove('sort-asc', 'sort-desc'));
        sortRowsBy('rowIndex', 'number', true);
        return;
      }

      rows.forEach(row => {
        const moves = [row.dataset.fastAttack, row.dataset.chargedAttack1, row.dataset.chargedAttack2];
        const knownTypes = moves.map(m => moveType(m ?? '')).filter((t): t is string => Boolean(t));

        const moveCells = row.querySelectorAll<HTMLElement>('.pokemon-move-cell');
        moveCells.forEach((cell, i) => {
          const badge = cell.querySelector<HTMLElement>('.move-eff');
          if (badge) setMoveBadge(badge, moves[i], bossType);
        });

        const cell = row.querySelector<HTMLElement>('.raid-eff-cell');

        if (knownTypes.length === 0) {
          // No move has a recorded type (e.g. "Smack Down / Mud-Slap" with
          // no type listed) - unknown, not "no effect".
          row.dataset.raidEff = '-1';
          if (cell) {
            cell.textContent = 'No move type data';
            cell.className = 'raid-eff-cell raid-eff-unknown';
          }
          return;
        }

        const best = knownTypes.reduce((max, t) => Math.max(max, effectiveness(t, bossType)), 0);
        row.dataset.raidEff = String(best);
        if (cell) {
          const label = EFFECT_LABEL[best] ?? 'Neutral';
          cell.textContent = `${best}× ${label}`;
          cell.className = `raid-eff-cell raid-eff-${String(best).replace('.', '_')}`;
        }
      });

      sortKey = 'raidEff';
      sortAsc = false;
      setActiveSortHeader('raidEff', false);
      sortRowsBy('raidEff', 'number', false);
    });
  });
</script>
