---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Home">
  <section class="hero">
    <h1>Lucky Penny Kitties</h1>
    <p class="tagline">A foster-based cat rescue giving cats and kittens a second chance at a home.</p>
    <a class="cta" href="/cats">Meet our adoptable cats &rarr;</a>
  </section>

  <section class="section">
    <h2>Our Mission</h2>
    <p>
      We pull cats and kittens from crowded shelters and the streets, place them in loving foster
      homes, and find them permanent families. Every cat in our care is vetted, vaccinated, and
      spayed or neutered before adoption.
    </p>
  </section>

  <section class="section grid-3">
    <a class="card" href="/foster" style="color:inherit;text-decoration:none;">
      <h3>Foster</h3>
      <p>Open your home temporarily and help a cat get ready for its forever family.</p>
    </a>
    <a class="card" href="/cats" style="color:inherit;text-decoration:none;">
      <h3>Adopt</h3>
      <p>Browse our current cats and kittens looking for a permanent home.</p>
    </a>
    <a class="card" href="/donate" style="color:inherit;text-decoration:none;">
      <h3>Donate</h3>
      <p>Support food, medical care, and supplies for cats in foster care.</p>
    </a>
  </section>

  <section class="section" style="text-align:center;">
    <div class="button-row">
      <a class="cta cta--secondary" href="/volunteer">Volunteer</a>
      <a class="cta cta--secondary" href="/events">Upcoming Events</a>
      <a class="cta cta--secondary" href="/sponsors">Our Sponsors</a>
      <a class="cta cta--secondary" href="/contact">Contact Us</a>
    </div>
  </section>
</Layout>
