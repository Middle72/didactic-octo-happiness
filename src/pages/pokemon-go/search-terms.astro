---
import Layout from '../../layouts/Layout.astro';
import PokemonNav from '../../components/PokemonNav.astro';
import Pokeball from '../../components/Pokeball.astro';
import { SEARCH_TERM_SECTIONS } from '../../data/search-terms';
---
<Layout title="Search Terms - Pokemon GO" description="Handy in-game search syntax for managing Mega Evolutions.">
  <section class="section pokemon-page">
    <h1><Pokeball class="spin-on-hover" /> Search Terms</h1>
    <p class="pokemon-subtitle">
      Copy-paste search syntax for the in-game Pokemon storage search bar &mdash; mostly for managing
      Mega Evolution levels and cooldowns.
    </p>

    <PokemonNav current="search-terms" />

    {SEARCH_TERM_SECTIONS.map(section => (
      <div class="card search-section">
        <h2 class="search-heading">{section.heading}</h2>
        <div class="search-table-wrap">
          <table class="search-table">
            <thead>
              <tr>
                <th>Search Syntax</th>
                <th>What It Pulls</th>
                <th>{section.useCaseHeader ?? 'Practical Use Case'}</th>
              </tr>
            </thead>
            <tbody>
              {section.rows.map(row => (
                <tr>
                  <td class="search-syntax-cell"><code>{row.syntax}</code></td>
                  <td>{row.pulls}</td>
                  <td>{row.useCase}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}

    <div class="card search-section">
      <h2 class="search-heading">Saving to Pokemon GO "Favorites"</h2>
      <p>To avoid typing these every session:</p>
      <ol class="search-steps">
        <li>Tap the Search Bar in your Pokemon storage.</li>
        <li>Tap See More in the top-right corner.</li>
        <li>Long-press any recent search under Recent to pin it into your Favorites tray.</li>
      </ol>
    </div>

    <div class="card search-section">
      <h2 class="search-heading">Recommended 3-Step Daily Routine</h2>
      <ol class="search-steps">
        <li>
          Lock Keepers: Run <code>4* &amp; !favorite</code> and <code>3* &amp; !# &amp; !favorite</code> &rarr; star or tag the ones with 15 Attack.
        </li>
        <li>
          Scan PvP / Trophies: Run <code>0-1attack &amp; 3-4defense &amp; 3-4hp &amp; cp-2500 &amp; !# &amp; !favorite</code> &rarr; tag any top league contenders.
        </li>
        <li>
          Purge the Rest: Run the Master Trash Purge string &rarr; tap Select All &rarr; Transfer.
        </li>
      </ol>
    </div>
  </section>
</Layout>
