---
import Layout from '../../layouts/Layout.astro';
import PokemonNav from '../../components/PokemonNav.astro';
import PokemonTable from '../../components/PokemonTable.astro';
import Pokeball from '../../components/Pokeball.astro';
import { TRAINERS, POKEMON } from '../../data/pokemon';
---
<Layout title="Pokemon GO" description="Shared Pokemon GO collection and upgrade-plan tracker.">
  <section class="section pokemon-page">
    <h1><Pokeball class="spin-on-hover" /> Pokemon GO Tracker</h1>
    <p class="pokemon-subtitle">
      Shared view of what each of us has caught and what we're planning to power up or evolve next.
    </p>

    <PokemonNav />

    <div class="pokemon-trainers">
      {TRAINERS.map(t => (
        <div class="card pokemon-trainer">
          <h2><Pokeball /> <a href={`/pokemon-go/${t.slug}`}>{t.name}</a></h2>
          <PokemonTable pokemon={POKEMON[t.slug] ?? []} />
        </div>
      ))}
    </div>
  </section>
</Layout>
