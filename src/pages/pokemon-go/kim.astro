---
import Layout from '../../layouts/Layout.astro';
import PokemonNav from '../../components/PokemonNav.astro';
import PokemonTable from '../../components/PokemonTable.astro';
import PriorityTable from '../../components/PriorityTable.astro';
import Pokeball from '../../components/Pokeball.astro';
import { POKEMON } from '../../data/pokemon';
import { PRIORITIES } from '../../data/priorities';
---
<Layout title="Kim - Pokemon GO" description="Kim's Pokemon GO collection and upgrade plans.">
  <section class="section pokemon-page">
    <h1><Pokeball class="spin-on-hover" /> Kim</h1>

    <PokemonNav current="kim" />

    <PriorityTable priorities={PRIORITIES.kim ?? []} />

    <div class="pokemon-trainers">
      <div class="card pokemon-trainer">
        <PokemonTable pokemon={POKEMON.kim ?? []} />
      </div>
    </div>
  </section>
</Layout>
