---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Volunteer" description="Not everyone can foster, and that's okay! Lucky Penny Kitties runs entirely on volunteers, and there are countless ways to help.">
  <section class="page-intro">
    <h1>Volunteer With Us</h1>
  </section>

  <section class="section" style="max-width:720px;margin-left:auto;margin-right:auto;text-align:center;">
    <p>
      <strong>Not everyone can foster — and that's okay! Lucky Penny Kitties runs entirely on
      volunteers, and there are countless ways to help that don't involve bringing a cat home.</strong>
    </p>
    <p>
      Volunteers help staff our events like Bingo nights and community fundraisers, transport cats
      to and from vet appointments, assist with social media and photography, help clean and
      organize supplies, and support our fundraising and admin work behind the scenes. Whatever
      your skills or the time you have to give, there's a place for you on our team.
    </p>
    <p>
      Interested in joining us? Fill out our Volunteer Interest Form and we'll be in touch about
      opportunities that fit your schedule.
    </p>

    <div class="button-row">
      <a href="https://docs.google.com/forms/d/e/1FAIpQLSeJC6Ismy7TbKn_jYmzsJmkWO5jvNfHYeZBmqaPZh234FWKAA/viewform" target="_blank" rel="noopener" class="cta">Apply to Volunteer</a>
    </div>
  </section>
</Layout>
