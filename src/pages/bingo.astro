---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Bingo Caller" description="Live number caller for the Lucky Penny Kitties bingo fundraiser.">
  <section class="section bingo-caller">
    <h1>Bingo Night</h1>

    <div class="bingo-current">
      <div id="current-call" class="current-call">Ready</div>
      <div id="current-count" class="current-count">0 of 75 called</div>
    </div>

    <div class="bingo-controls">
      <button id="call-next" class="cta">Call Next Number</button>
      <button id="reset" class="secondary-btn">Reset Game</button>
    </div>

    <div id="recent-calls" class="recent-calls"></div>

    <div id="bingo-board" class="bingo-board"></div>
  </section>

  <script>
    const LETTERS = ['B', 'I', 'N', 'G', 'O'] as const;
    const STORAGE_KEY = 'bingo-caller-state';

    interface BingoState {
      pool: number[];
      called: number[];
    }

    function letterFor(n: number): string {
      if (n <= 15) return 'B';
      if (n <= 30) return 'I';
      if (n <= 45) return 'N';
      if (n <= 60) return 'G';
      return 'O';
    }

    function shuffledPool(): number[] {
      const pool = Array.from({ length: 75 }, (_, i) => i + 1);
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
      }
      return pool;
    }

    function loadState(): BingoState {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed.pool) && Array.isArray(parsed.called)) return parsed;
        }
      } catch {
        // fall through to a fresh game
      }
      return { pool: shuffledPool(), called: [] };
    }

    function saveState(state: BingoState) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    }

    let state = loadState();

    const currentCallEl = document.getElementById('current-call')!;
    const currentCountEl = document.getElementById('current-count')!;
    const recentCallsEl = document.getElementById('recent-calls')!;
    const boardEl = document.getElementById('bingo-board')!;
    const callButton = document.getElementById('call-next') as HTMLButtonElement;
    const resetButton = document.getElementById('reset') as HTMLButtonElement;

    function buildBoard() {
      boardEl.innerHTML = '';
      LETTERS.forEach((letter, colIndex) => {
        const col = document.createElement('div');
        col.className = 'bingo-column';

        const heading = document.createElement('div');
        heading.className = 'bingo-column-letter';
        heading.textContent = letter;
        col.appendChild(heading);

        for (let row = 0; row < 15; row++) {
          const n = colIndex * 15 + row + 1;
          const cell = document.createElement('div');
          cell.className = 'bingo-number';
          cell.dataset.number = String(n);
          cell.textContent = String(n);
          col.appendChild(cell);
        }

        boardEl.appendChild(col);
      });
    }

    function render() {
      const lastCalled = state.called[0];

      if (lastCalled === undefined) {
        currentCallEl.textContent = 'Ready';
      } else {
        currentCallEl.textContent = `${letterFor(lastCalled)}-${lastCalled}`;
      }

      currentCountEl.textContent = `${state.called.length} of 75 called`;

      recentCallsEl.innerHTML = '';
      state.called.slice(1, 6).forEach(n => {
        const chip = document.createElement('span');
        chip.className = 'recent-chip';
        chip.textContent = `${letterFor(n)}-${n}`;
        recentCallsEl.appendChild(chip);
      });

      const calledSet = new Set(state.called);
      boardEl.querySelectorAll<HTMLElement>('.bingo-number').forEach(cell => {
        const n = Number(cell.dataset.number);
        cell.classList.toggle('called', calledSet.has(n));
        cell.classList.toggle('just-called', n === lastCalled);
      });

      if (state.pool.length === 0) {
        callButton.disabled = true;
        callButton.textContent = 'All numbers called!';
      } else {
        callButton.disabled = false;
        callButton.textContent = 'Call Next Number';
      }
    }

    function callNext() {
      if (state.pool.length === 0) return;
      const next = state.pool.pop()!;
      state.called.unshift(next);
      saveState(state);
      render();
    }

    function resetGame() {
      if (!confirm('Reset the bingo game? This clears all called numbers.')) return;
      state = { pool: shuffledPool(), called: [] };
      saveState(state);
      render();
    }

    callButton.addEventListener('click', callNext);
    resetButton.addEventListener('click', resetGame);

    document.addEventListener('keydown', e => {
      if (e.code === 'Space' && document.activeElement !== resetButton) {
        e.preventDefault();
        callNext();
      }
    });

    buildBoard();
    render();
  </script>
</Layout>
