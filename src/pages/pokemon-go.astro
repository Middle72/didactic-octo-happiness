      iv: '44/45 (97.8% / 3★)',
      fastAttack: 'Dragon Breath (Dragon)',
      chargedAttack1: 'Hurricane (Flying)',
      chargedAttack2: '—',
      notes: 'Elite 98% (15/15/14) investment; far superior stats to MegDragonite',
    },
    {
      name: 'Gible',
      types: 'Dragon / Ground',
      cp: 749,
      levelRange: '~24–25',
      atk: 12,
      def: 11,
      hp: 11,
      iv: '34/45 (75.6% / 2★)',
