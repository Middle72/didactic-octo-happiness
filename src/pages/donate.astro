---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Donate" description="Every penny counts and goes towards rescuing and rehoming kitties in North East Iowa. Give via Venmo, PayPal, or GivingGrid.">
  <section class="page-intro">
    <h1>Donate</h1>
    <p>Every penny counts &amp; goes towards rescuing + rehoming kitties in North East Iowa.</p>
  </section>

  <section class="section" style="max-width:720px;margin-left:auto;margin-right:auto;text-align:center;">
    <h2>Our Mission</h2>
    <p>
      At <strong>Lucky Penny Kitties</strong>, our mission is to rescue, rehabilitate, and advocate
      for cats and kittens in need by providing compassionate, foster-based care and helping them
      find loving forever homes. As a no-kill rescue, we believe every animal deserves a second
      chance, regardless of age, medical needs, or circumstance.
    </p>
  </section>

  <section class="section donate-options">
    <div class="donate-option">
      <span class="eyebrow">Prefer Venmo?</span>
      <h2>Send Your Gift via Venmo</h2>
      <p>You can also support Lucky Penny Kitties directly through Venmo.</p>
      <a href="https://venmo.com/u/luckypennykittiesia" target="_blank" rel="noopener" class="cta">VENMO</a>
    </div>

    <div class="donate-option">
      <span class="eyebrow">Prefer PayPal?</span>
      <h2>Give via PayPal</h2>
      <p>You can also make a secure donation directly through PayPal.</p>
      <a href="https://www.paypal.com/ncp/payment/4Z3UYSJLHHBBN" target="_blank" rel="noopener" class="cta">PAYPAL</a>
    </div>

    <div class="donate-option">
      <span class="eyebrow">Prefer GivingGrid?</span>
      <h2>Give via GivingGrid</h2>
      <p>You can also support Lucky Penny Kitties through our GivingGrid campaign.</p>
      <a href="https://www.givinggrid.com/bzaxvc/" target="_blank" rel="noopener" class="cta">GIVINGGRID</a>
    </div>
  </section>
</Layout>
